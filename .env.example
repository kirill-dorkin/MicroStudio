# Public configuration; replace only with verified production values.
# Canonical production URL, e.g. https://microstudio.kg (no trailing slash).
# Without it the Vercel production domain is used.
NEXT_PUBLIC_SITE_URL=
# WhatsApp number in international format, digits only (e.g. 996700779919).
# Leave empty to fall back to the number confirmed in src/config/site.ts;
# set to "off" to hide WhatsApp everywhere.
NEXT_PUBLIC_WHATSAPP_E164=
NEXT_PUBLIC_BUSINESS_EMAIL=
# Analytics only with actual account IDs and proper consent management:
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
